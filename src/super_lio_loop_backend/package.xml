<?xml version="1.0"?>
<package format="3">
  <name>super_lio_loop_backend</name>
  <version>0.1.0</version>
  <description>BTC loop detection, GTSAM pose graph, and OctreeGBA backend for Super-LIO.</description>

  <maintainer email="lswang@mail.ecust.edu.cn">Super-LIO maintainers</maintainer>
  <license>GPL-2.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>super_lio_loop_msgs</depend>

  <build_depend>eigen</build_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <build_depend>libgtsam-dev</build_depend>
  <exec_depend>libpcl-all</exec_depend>
  <exec_depend>libgtsam-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
